# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

# Web push (VAPID) — generate keys with Node.js Web Crypto API
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Admin / cron jobs
JOB_ADMIN_TOKEN=optional-secret-for-admin-endpoints

# Local dev only — bypasses OAuth, uses DEV_USER_EMAIL identity instead
# Never set these in production
BYPASS_AUTH=true
DEV_USER_EMAIL=you@example.com
